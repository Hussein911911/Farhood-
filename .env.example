# Local/demo development only. Copy to .env and replace every demo secret before deployment.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Local PostgreSQL. Create the database first, then run `npm run db:migrate`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farhood_dev
DB_POOL_MAX=10

# Demo-only peppers. Generate independent random values of at least 32 characters.
API_KEY_PEPPER=local-demo-api-pepper-change-me-0123456789
SESSION_PEPPER=local-demo-session-pepper-change-me-0123456789
# Base64 for a demo-only 32-byte AES-256 key. Replace with a generated random key.
MT5_ENCRYPTION_KEY=bG9jYWwtZGVtby1rZXktb25seS0zMi1ieXRlcyEhISE=

SYMBOL_MAP=EURUSD:EURUSDm,XAUUSD:XAUUSDm
MIN_WALLET_BALANCE_USD=5.00
FREE_TRIAL_DAYS=15
FREE_TRIAL_CREDIT_USD=10.00
PERFORMANCE_FEES_ENABLED=false
MAX_LOT=100
MAX_PENDING_SIGNALS=10000
BRIDGE_POLL_WAIT_MS=20000
BRIDGE_LEASE_MS=60000
BRIDGE_STALE_MS=45000
SESSION_TTL_HOURS=24

# NOWPayments only. Use the provider sandbox API host until production verification.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_API_BASE_URL=https://api-sandbox.nowpayments.io/v1
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_CALLBACK_URL=https://YOUR_PUBLIC_API_HOST/api/v1/payments/webhook
PAYMENT_MIN_USD=5.00
PAYMENT_MAX_USD=10000.00
# Example prices only. Replace with your published commercial plan prices.
SUBSCRIPTION_PRICES_USD={"BASIC":9.99,"PLUS":19.99,"PRO":49.99}

# Optional Telegram bot integration. Keep the token and webhook secret server-side.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://YOUR_PUBLIC_API_HOST/api/v1/notifications/telegram/webhook
TELEGRAM_CONNECT_CODE_TTL_MINUTES=15
